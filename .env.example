# Copie para .env e edite. Nunca envie o .env para o GitHub.

# Senha do banco PostgreSQL (invente uma longa)
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Usuários criados na 1ª execução (login:senha,login2:senha2). Cada um troca a sua pela tela depois.
APP_USUARIOS_INICIAIS=filipe:troque-esta-senha-1,vagner:troque-esta-senha-2

# Seu domínio (HTTPS automático, precisa apontar para o IP do servidor). Para testar sem domínio use :80
SITE_ADDRESS=planilha.seudominio.com.br
# true quando o site usa HTTPS (o normal); false só para testar em http://IP
COOKIE_SEGURO=true
