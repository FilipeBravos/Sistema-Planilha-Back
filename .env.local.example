# Copie para .env.local e edite (os scripts da pasta local/ fazem a cópia na 1ª vez).
# Este arquivo guarda senhas: não envie o .env.local para o GitHub (já está no .gitignore).

# Senha interna do banco: invente qualquer texto longo, você não vai precisar digitar.
POSTGRES_PASSWORD=troque-por-um-texto-longo-qualquer

# Quem pode entrar no sistema: login:senha,login2:senha2  (senha com 8+ caracteres, sem vírgula).
# Cada pessoa pode trocar a própria senha depois, pelo botão "Alterar senha".
APP_USUARIOS_INICIAIS=filipe:troque-esta-senha-1,vagner:troque-esta-senha-2

# Endereço: http://localhost:PORTA
PORTA=8080

# Acesso pela rede:
#   nao       = só este computador usa o sistema (padrão, mais seguro)
#   sim       = outros computadores/celulares do mesmo Wi-Fi também acessam, em http://IP-DESTE-COMPUTADOR:PORTA
#   tailscale = só este computador E quem recebeu acesso pelo Tailscale (VPN), usando o endereço Tailscale
#               deste computador; o Wi-Fi/rede local NÃO é aberto. Exige o Tailscale instalado e conectado (veja LOCAL.md).
# Escreva exatamente "nao", "sim" ou "tailscale", sem espaços. Depois de mudar, rode o iniciar de novo.
ACESSO_REDE=nao
